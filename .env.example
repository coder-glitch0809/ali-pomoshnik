# Nusxa oling: .env.example -> .env va to'ldiring

# ===== Asosiy miya: Claude (majburiy) =====
# https://console.anthropic.com dan olinadi
ANTHROPIC_API_KEY=sk-ant-...

ASSISTANT_NAME=Ali
USER_NAME=Abbos

# Model: claude-opus-5-5 (eng aqlli) | claude-sonnet-5-5 (tezroq, arzonroq) | claude-haiku-5-5 (eng arzon)
CLAUDE_MODEL=claude-opus-5-5
# Fikrlash chuqurligi: low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
# "Chuqur" tugmasi yoqilganda
CLAUDE_DEEP_EFFORT=xhigh
WEB_SEARCH=true
MAX_HISTORY_MESSAGES=80

# ===== Super miya: maslahatchi modellar (ixtiyoriy) =====
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro-latest
# Ovozli xabarlarni matnga aylantirish uchun (OpenAI kaliti bo'lmasa)
GEMINI_FAST_MODEL=gemini-flash-latest

# ===== Veb-sayt (telefon/kompyuter) =====
# Kirish paroli. Bo'sh qolsa avtomatik yaratiladi (data/password.txt)
ACCESS_PASSWORD=
PORT=8000

# ===== Telegram bot (ixtiyoriy) =====
# @BotFather -> /newbot -> token
TELEGRAM_BOT_TOKEN=
# Ruxsat berilgan Telegram ID lar (vergul bilan). Bo'sh bo'lsa: botga /login PAROL yozing
TELEGRAM_ALLOWED_USERS=

# ===== Shaxsiy ovoz (ixtiyoriy) =====
# Ovozingizni klonlash uchun: https://elevenlabs.io -> API keys
ELEVENLABS_API_KEY=
# Tayyor ovoz ID si bo'lsa (bo'lmasa Telegram'da /ovoz -> /ovoz_tayyor)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3

# ===== Instagram (ixtiyoriy, README -> Instagram) =====
IG_ACCESS_TOKEN=
# nom=instagram_business_account_id, vergul bilan
IG_ACCOUNTS=
IG_GRAPH_VERSION=v23.0

# ===== Ovoz =====
WAKE_WORDS=ali,али,jarvis
STT_LANGUAGE=uz-UZ
# uz-UZ-SardorNeural (erkak) | uz-UZ-MadinaNeural (ayol)
TTS_VOICE=uz-UZ-SardorNeural
# Faqat terminal rejimi (main.py --voice) uchun: edge | pyttsx3 | none
TTS_BACKEND=edge
