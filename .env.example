# Nusxa oling: .env.example -> .env va to'ldiring

# ===== Asosiy miya: Claude (majburiy) =====
# https://console.anthropic.com dan olinadi
ANTHROPIC_API_KEY=sk-ant-...

ASSISTANT_NAME=Ali
USER_NAME=Abbos

# Model: claude-opus-5-5 (eng aqlli) | claude-sonnet-5-5 (tezroq, arzonroq) | claude-haiku-5-5 (eng arzon)
CLAUDE_MODEL=claude-opus-5-5
# Fikrlash chuqurligi: low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
# "Chuqur" tugmasi yoqilganda
CLAUDE_DEEP_EFFORT=xhigh
WEB_SEARCH=true
MAX_HISTORY_MESSAGES=80

# ===== Super miya: maslahatchi modellar (ixtiyoriy) =====
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro-latest
# Ovozli xabarlarni matnga aylantirish uchun (OpenAI kaliti bo'lmasa)
GEMINI_FAST_MODEL=gemini-flash-latest

# ===== Veb-sayt (telefon/kompyuter) =====
# Kirish paroli. Bo'sh qolsa avtomatik yaratiladi (data/password.txt)
ACCESS_PASSWORD=
PORT=8000

# ===== Telegram bot (ixtiyoriy) =====
# @BotFather -> /newbot -> token
TELEGRAM_BOT_TOKEN=
# Ruxsat berilgan Telegram ID lar (vergul bilan). Bo'sh bo'lsa: botga /login PAROL yozing
TELEGRAM_ALLOWED_USERS=
# Shaxsiy sozlamalar va Mini App faqat shu Telegram ID uchun.
TELEGRAM_OWNER_ID=

# ===== Shaxsiy ovoz (ixtiyoriy) =====
# Ovozingizni klonlash uchun: https://elevenlabs.io -> API keys
ELEVENLABS_API_KEY=
# Tayyor ovoz ID si bo'lsa (bo'lmasa Telegram'da /ovoz -> /ovoz_tayyor)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3

# ===== Instagram (ixtiyoriy, README -> Instagram) =====
IG_ACCESS_TOKEN=
# nom=instagram_business_account_id, vergul bilan
IG_ACCOUNTS=
IG_GRAPH_VERSION=v23.0

# ===== Ovoz =====
WAKE_WORDS=ali,али,jarvis
STT_LANGUAGE=uz-UZ
# uz-UZ-SardorNeural (erkak) | uz-UZ-MadinaNeural (ayol)
TTS_VOICE=uz-UZ-SardorNeural
# Faqat terminal rejimi (main.py --voice) uchun: edge | pyttsx3 | none
TTS_BACKEND=edge

# ===== Dasturlash: GitHub, Vercel, kompyuterdagi loyihalar (ixtiyoriy) =====
# https://github.com/settings/tokens -> Fine-grained token (All repositories; Contents, Issues, Pull requests, Actions: Read and write)
GITHUB_TOKEN=
# https://vercel.com/account/tokens -> Create Token
VERCEL_TOKEN=
# Jamoa (team) loyihalari bo'lsa: Vercel -> Settings -> Team ID
VERCEL_TEAM_ID=
# Loyihalar papkalari (bir nechta bo'lsa ; bilan). Bo'sh bo'lsa - Ali turgan papkaning ota papkasi + VS Code'da ochilganlar
PROJECTS_DIRS=
# Claude Code / Codex vazifasi uchun maksimal vaqt (daqiqa)
CODE_TASK_MINUTES=30

# ===== Avtopilot (ixtiyoriy, API'dan pul sarflaydi) =====
# Agentlar o'z "o'rganish" mavzulari bo'yicha yangiliklarni o'zi o'rganib, bilimlar bazasiga yozadi
AUTO_LEARN=false
AUTO_LEARN_HOURS=24
# Dasturchi agent treyding loyihalarini (kompyuter, GitHub, Vercel) tekshirib, muammo bo'lsa xabar beradi
WATCH_PROJECTS=false
WATCH_HOURS=6

# 24/7 server va Telegram ichidagi to'liq sayt
# Render avtomatik RENDER_EXTERNAL_URL beradi; boshqa hostingda PUBLIC_URL ni yozing.
PUBLIC_URL=
TELEGRAM_BOT_NAME=Ali Pomoshnik
# Doimiy disk manzili, Render uchun /var/data. Mahalliy ishlashda bo'sh qoldiring.
# ALI_STATE_DIR=/var/data
# Faqat Vercel gateway uchun: doimiy serverning HTTPS manzili.
ALI_BACKEND_URL=
