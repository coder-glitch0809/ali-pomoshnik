rules_version = '2';
// Ali: har bir foydalanuvchi faqat o'z ma'lumotini ko'radi va o'zgartiradi.
//   users/{uid}                 - profil: ism, platforma, ruxsatlar holati
//   users/{uid}/messages/{id}   - suhbat xabarlari
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'platform', 'flavor', 'permissions', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80;

      match /messages/{messageId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['role', 'content', 'actions', 'createdAt'])
          && request.resource.data.role in ['user', 'assistant']
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 20000;
        allow update: if false;
      }
    }

    // Boshqa hamma narsa yopiq
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
